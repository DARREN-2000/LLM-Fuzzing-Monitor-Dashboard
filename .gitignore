# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
sdist/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor settings
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# Testing / coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.tox/
.nox/

# mypy / type checkers
.mypy_cache/
.dmypy.json

# Logs and databases
*.log
*.sqlite3
*.db

# OS files
.DS_Store
Thumbs.db

# Experiment artefacts (generated at runtime)
experiments/
results/
temp/
output/
*.tar.gz
*.zip
*.lz4

# Secrets — never commit these
.env
.env.*
!.env.example
